/storage/pail
/vendor

# قاعدة البيانات حالة تشغيلية (جلسات + طلبات تجريبية) لا تُحفظ في المستودع.
# النسخة الاحتياطية اليدوية تُحفظ في database/backups/ وهي مستثناة أيضًا.
/database/*.sqlite
/database/backups/

