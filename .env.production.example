# ═══════════════════════════════════════════════════════════════
#  قالب بيئة الإنتاج — متجر NADAF | نداف
# ═══════════════════════════════════════════════════════════════
#  الاستخدام:
#    1. انسخ هذا الملف على الخادم باسم .env
#    2. عدّل القيم بين < > فقط
#    3. شغّل:  php artisan deploy:check
#       (يفحص كل شيء ويخبرك بما ينقص قبل فتح المتجر للناس)
#
#  ⚠️ هذا القالب لا يحوي أي سرّ حقيقي — كل القيم placeholders.
#  ⚠️ لا ترفع ملف .env الحقيقي إلى أي مستودع، ولا تنسخه عبر FTP مرتين.
# ═══════════════════════════════════════════════════════════════

# ── أساسيات ──────────────────────────────────────────────────
APP_NAME="NADAF | نداف"
APP_ENV=production          # ⚠️ لا تتركها local على خادم حقيقي
APP_KEY=                    # ولّدها: php artisan key:generate
APP_DEBUG=false             # ⚠️ true هنا يكشف مسارات الملفات للزائرين
APP_URL=https://<your-domain.com>   # النطاق الحقيقي — بلا شرطة مائلة أخيرة

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

# في الإنتاج: يفضل `database` ليستمر وضع الصيانة عبر الطلبات المتعددة
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ── السجلات ──────────────────────────────────────────────────
# `debug` في الإنتاج يملأ القرص ويكشف بيانات — اجعلها error أو warning
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── قاعدة البيانات ────────────────────────────────────────────
# SQLite مقبولة للتجربة فقط: أقفال الكتابة تعطّل الطلبات المتزامنة.
# على استضافة فعلية استخدم MySQL كما في DEPLOY.md.
DB_CONNECTION=mysql
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# ── الجلسات والطوابير ────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true        # ← true في الإنتاج
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true  # ← يتطلب HTTPS فعّالًا

BROADCAST_CONNECTION=log

# ⚠️ ملفات الرفع تُخزَّن في public/storage (قرص public) بلا رابط رمزي،
#    ليعمل النشر على استضافة FTP لا تدعم symlinks. لا تغيّره.
FILESYSTEM_DISK=public

# الإشعارات (تيليجرام/بريد) تعمل متزامنة مع الطلب؛ على استضافة تدعم
# العمال اجعلها database وشغّل: php artisan queue:work
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

# ── البريد ───────────────────────────────────────────────────
# ⚠️ MAIL_MAILER=log يعني أن الرسائل تُكتب في السجل ولا تُرسل أبدًا —
#    به تفشل استعادة كلمة المرور بصمت. استخدم SMTP فعليًا.
# Brevo مجاني حتى 300 رسالة يوميًا: smtp-relay.brevo.com : 587
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS="store@nadaf.sy"
MAIL_FROM_NAME="${APP_NAME}"

# ── اختياري ──────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

VITE_APP_NAME="${APP_NAME}"
